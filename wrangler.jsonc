{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khatiib",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [
    { "pattern": "khatiib.online/*", "custom_domain": true },
    { "pattern": "www.khatiib.online/*", "custom_domain": true }
  ]
}
